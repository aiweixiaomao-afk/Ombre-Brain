[Unit]
Description=Ombre Brain memory MCP (localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/ombre-brain
EnvironmentFile=/home/admin/ombre-brain/ob-private.env
Environment=OMBRE_BIND_HOST=127.0.0.1
Environment=OMBRE_PORT=18001
Environment=OMBRE_TRUSTED_PROXY_CIDRS=127.0.0.1/32
ExecStart=/home/admin/ombre-brain/.venv/bin/python /home/admin/ombre-brain/src/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
